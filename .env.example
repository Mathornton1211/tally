# Copy to .env, or just run scripts/install.sh which writes this for you.
# Everything without a default is required.

# ---------------------------------------------------------------- secrets
# Generated by the installer. The Fernet key encrypts your Plaid access tokens:
# lose it and every bank has to be reconnected, leak it and a stolen database
# dump becomes readable. Keep a copy in a password manager.
TALLY_DB_PASSWORD=
TALLY_FERNET_KEY=

# ---------------------------------------------------------------- the front door
# password : Tally asks. Each person in the household has their own login, and
#            the session says which of them is asking -- which is what makes a
#            private account actually private. Use this unless something else
#            already authenticates.
# proxy    : trust the reverse proxy in front (Authentik, oauth2-proxy, Tailscale
#            Serve). Tally adds nothing of its own. NOTE: in this mode the person
#            switcher is a convenience, not a wall -- anyone past the proxy can
#            view as anyone. Fine for a single-admin homelab; use password mode
#            for a household where people keep private accounts.
TALLY_AUTH=password
# Only used once: it creates the first person on an empty install. After that,
# people are managed in the app and this stops mattering.
TALLY_PASSWORD=

# ---------------------------------------------------------------- Plaid
# https://dashboard.plaid.com/signup -> Developers -> Keys.
# sandbox = fake banks, unlimited, free. production = real banks; the free Trial
# plan allows 10 connected items.
PLAID_ENV=sandbox
PLAID_CLIENT_ID=
PLAID_SECRET_SANDBOX=
PLAID_SECRET_PRODUCTION=
# Only needed for banks that use OAuth (Chase, Capital One, Amex, BofA...), and
# only over HTTPS. Must match a URI allowlisted in the Plaid dashboard exactly.
PLAID_REDIRECT_URI=

# ---------------------------------------------------------------- what day it is
# Used by both the app and the database, so they always agree on the date.
# Leave it UTC only if you actually live in UTC -- otherwise a transaction near
# midnight lands in the wrong day, and near month-end in the wrong month.
TALLY_TIMEZONE=America/Los_Angeles

# ---------------------------------------------------------------- where it listens
# 127.0.0.1 means this machine only. See "Putting it on the network" in the
# README before changing it to 0.0.0.0.
TALLY_BIND=127.0.0.1
TALLY_PORT=8099
TALLY_BASE_URL=http://localhost:8099

# ---------------------------------------------------------------- local AI
# Every page works with this off; the assistant, merchant clean-up and the
# monthly recap are what you lose. Tally refuses a non-local model host: bank
# data is not going to a cloud API.
AI_ENABLED=0
OLLAMA_URL=http://host.docker.internal:11434
AI_MODEL=llama3.1:8b

# ---------------------------------------------------------------- phone alerts
# Optional. An ntfy topic, public or your own server. The topic name is the only
# secret, so let the installer generate one rather than picking something guessable.
NTFY_URL=
NTFY_TOPIC=

# How often to pull new transactions. 21600 = every six hours; banks do not
# update faster than that and Plaid bills per call on paid plans.
SYNC_INTERVAL_SECONDS=21600
